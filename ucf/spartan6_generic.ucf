NET "clk_in" LOC = "V10";  
NET "clk_in" IOSTANDARD = LVCMOS33;
TIMESPEC TS_clk_in = PERIOD "clk_in" 20.0 ns HIGH 50%;  
NET "rst_n" LOC = "B8";   
NET "rst_n" IOSTANDARD = LVCMOS33;
NET "rst_n" PULLUP;
NET "uart_rx" LOC = "N17";  
NET "uart_rx" IOSTANDARD = LVCMOS33;
NET "btn_commit" LOC = "P4";  
NET "btn_commit" IOSTANDARD = LVCMOS33;
NET "btn_commit" PULLUP;
NET "btn_clear" LOC = "P3";   
NET "btn_clear" IOSTANDARD = LVCMOS33;
NET "btn_clear" PULLUP;
NET "vga_hs" LOC = "N6";     
NET "vga_hs" IOSTANDARD = LVCMOS33;
NET "vga_hs" DRIVE = 8;
NET "vga_hs" SLEW = FAST;
NET "vga_vs" LOC = "P7";     
NET "vga_vs" IOSTANDARD = LVCMOS33;
NET "vga_vs" DRIVE = 8;
NET "vga_vs" SLEW = FAST;
NET "vga_r<0>" LOC = "U7";   
NET "vga_r<1>" LOC = "V7";   
NET "vga_r<2>" LOC = "N7";   
NET "vga_r<3>" LOC = "P8";   
NET "vga_r<*>" IOSTANDARD = LVCMOS33;
NET "vga_r<*>" DRIVE = 8;
NET "vga_r<*>" SLEW = FAST;
NET "vga_g<0>" LOC = "T6";   
NET "vga_g<1>" LOC = "V6";   
NET "vga_g<2>" LOC = "R7";   
NET "vga_g<3>" LOC = "T7";   
NET "vga_g<*>" IOSTANDARD = LVCMOS33;
NET "vga_g<*>" DRIVE = 8;
NET "vga_g<*>" SLEW = FAST;
NET "vga_b<0>" LOC = "R6";   
NET "vga_b<1>" LOC = "T8";   
NET "vga_b<2>" LOC = "V8";   
NET "vga_b<3>" LOC = "U8";   
NET "vga_b<*>" IOSTANDARD = LVCMOS33;
NET "vga_b<*>" DRIVE = 8;
NET "vga_b<*>" SLEW = FAST;
NET "led<0>" LOC = "U16";       
NET "led<1>" LOC = "V16";       
NET "led<2>" LOC = "U15";       
NET "led<3>" LOC = "V15";       
NET "led<*>" IOSTANDARD = LVCMOS33;
NET "led<*>" DRIVE = 8;
NET "pix_clk_gen_inst/pix_bufg/O" TNM_NET = "pix_clk";
TIMESPEC TS_pix_clk = PERIOD "pix_clk" 40.0 ns HIGH 50%;
